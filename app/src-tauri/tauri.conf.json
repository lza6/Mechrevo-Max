{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mechrevo-Max",
  "version": "0.1.2",
  "identifier": "com.mechrevo.max",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "机械革命控制台 · Mechrevo-Max",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --force-renderer-accessibility"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/icon.png"]
  }
}
